# RSCON Environment Variables
# Copy to .env or export before running rscond.

# Database
RSCON_DATABASE_URL=postgres://rscon:rscon@localhost:5432/rscon?sslmode=disable

# Bootstrap administrator password (must be at least 12 characters, Argon2id hashed)
# This is used only the first time to create the initial admin user.
RSCON_BOOTSTRAP_ADMIN_PASSWORD=StrongPassword123!

# API (frontend connects to this)
RSCON_API_URL=http://127.0.0.1:18080

# TLS verification skip for local dev only (never set in production)
# RSCON_SKIP_TLS_VERIFY=false

# Vault (production CA)
# Uncomment and configure for Vault-backed certificate authority:
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_NAMESPACE=admin
# VAULT_SSH_MOUNT=ssh-client-signer
# VAULT_SIGNING_ROLE=rscon-users
# VAULT_ROLE_ID_FILE=/etc/rscon/vault_role_id
# VAULT_SECRET_ID_FILE=/etc/rscon/vault_secret_id

# Local file CA (development only, refused in production)
# Uncomment one of the following if you know what you're doing:
# RSCON_DEV_INSECURE_FILE_CA=true
# RSCON_FILE_CA_KEY_FILE=/path/to/ca/key

# Logging
RSCON_LOG_LEVEL=info
RSCON_LOG_FORMAT=json

# End of environment variables
